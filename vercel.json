{
  "buildCommand": "npx convex deploy --cmd 'next build'",
  "crons": [
    {
      "path": "/api/sales/refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/reports/auto-process",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/dunlop/monthly-run",
      "schedule": "0 14 1 * *"
    }
  ],
  "functions": {
    "app/api/reports/inventory-data/route.ts": {
      "memory": 2048,
      "maxDuration": 90
    },
    "app/api/reports/custom-data/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    }
  }
}
